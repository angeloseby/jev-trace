FROM python:3.11-slim
WORKDIR /app
RUN adduser --disabled-password --gecos "" appuser
COPY apps/api/pyproject.toml ./
RUN pip install --no-cache-dir fastapi uvicorn[standard] gunicorn pydantic pydantic-settings sqlalchemy[asyncio] asyncpg alembic redis celery python-jose[cryptography] passlib[bcrypt] httpx python-multipart opentelemetry-api opentelemetry-sdk typesafe-sdk slowapi limits
COPY apps/api/ ./
COPY packages/ /packages/
RUN pip install --no-cache-dir /packages/schemas /packages/jev-client /packages/trace-parser /packages/attribution /packages/analytics /packages/tracer
RUN chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["sh", "-c", "alembic upgrade head && gunicorn app.main:app -k uvicorn.workers.UvicornWorker --workers 2 --bind 0.0.0.0:8000"]
